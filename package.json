{
  "name": "muhadatsah",
  "version": "1.0.0",
  "private": true,
  "description": "Platform belajar percakapan Bahasa Arab & Inggris: dialog, kosakata, audio pelafalan, dan kuis interaktif.",
  "keywords": [
    "arabic",
    "bahasa-arab",
    "muhadatsah",
    "conversation",
    "language-learning",
    "quiz",
    "supabase"
  ],
  "license": "MIT",
  "author": "Muhadatsah Contributors",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "http-server . -p 5173 -c-1 -o",
    "start": "npm run dev",
    "serve": "http-server . -p 5173 -c-1",
    "lint": "eslint \"assets/js/**/*.js\"",
    "lint:fix": "eslint \"assets/js/**/*.js\" --fix",
    "format": "prettier --write \"**/*.{js,json,html,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,html,css,md,yml,yaml}\"",
    "check": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.3"
  }
}
