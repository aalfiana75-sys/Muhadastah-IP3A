# =============================================
# Muhadatsah — contoh environment variables
# Copy file ini menjadi `.env` lalu isi nilai aslinya.
# JANGAN commit file `.env` ke Git.
# =============================================

# --- Supabase ---
# Ambil dari: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Aktifkan integrasi Supabase (true/false)
SUPABASE_ENABLED=false

# --- Dev server ---
# Port untuk `npm run dev` (static server lokal)
PORT=5173
